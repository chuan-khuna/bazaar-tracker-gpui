# Copy to .env (gitignored) and fill in. Real environment variables win over this file.

# Any OpenAI-compatible endpoint. OpenRouter by default; for a local model, e.g.
# http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio).
ADVISOR_BASE_URL=https://openrouter.ai/api/v1
# The endpoint's key (https://openrouter.ai/settings/keys, starts with sk-or-). Needed for
# OpenRouter; a local model needs none. The only name read for the key.
OPENROUTER_API_KEY=
# The model id, as the endpoint names it.
ADVISOR_MODEL=nvidia/nemotron-3.5-super-vl:free
# The port `just advisor serve` listens on, on 127.0.0.1 only.
ADVISOR_PORT=8420
# The tracker's data folder (history.db, raw_data/). Unset: <repo>/.bazaar-tracker
# BAZAAR_TRACKER_DATA_DIR=
